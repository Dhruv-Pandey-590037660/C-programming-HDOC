BT 1 0 0 1 5 271.6 Tm /F3 7.4 Tf 9.3 TL (#include <stdio.h>) Tj T*  T* (void countElements\(\)) Tj T* ({) Tj T* (    int a[100], n, i;) Tj T* (    int even = 0, odd = 0, positive = 0, negative = 0, zero = 0;) Tj T*  T* (    printf\("Enter number of elements: "\);) Tj T* (    scanf\("%d", &n\);) Tj T*  T* (    printf\("Enter %d elements:\\n", n\);) Tj T* (    for \(i = 0; i < n; i++\)) Tj T* (        scanf\("%d", &a[i]\);) Tj T*  T* (    for \(i = 0; i < n; i++\)) Tj T* (    {) Tj T* (        if \(a[i] % 2 == 0\)) Tj T* (            even++;) Tj T* (        else) Tj T* (            odd++;) Tj T*  T* (        if \(a[i] > 0\)) Tj T* (            positive++;) Tj T* (        else if \(a[i] < 0\)) Tj T* (            negative++;) Tj T* (        else) Tj T* (            zero++;) Tj T* (    }) Tj T*  T* (    printf\("Even elements = %d\\n", even\);) Tj T* ET
Q
 

